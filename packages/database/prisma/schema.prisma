// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events       Event[]
  comments     Comment[]
  commentLikes CommentLike[]
  ratings      Rating[]

  @@map("users")
}

model Event {
  id          String      @id @default(uuid())
  title       String      @db.VarChar(255)
  description String      @db.Text
  location    String?     @db.VarChar(255)
  venue       String?     @db.VarChar(255)
  startDate   DateTime    @map("start_date")
  endDate     DateTime?   @map("end_date")
  imageUrl    String?     @map("image_url") @db.VarChar(500)
  videoUrl    String?     @map("video_url") @db.VarChar(500)
  price       Decimal?    @db.Decimal(10, 2)
  source      String      @db.VarChar(100) // manual or crawler
  sourceUrl   String?     @map("source_url") @db.VarChar(500)
  categoryId  String      @map("category_id")
  createdBy   String?     @map("created_by")
  isActive    Boolean     @default(true) @map("is_active")
  status      EventStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  category Category   @relation(fields: [categoryId], references: [id])
  creator  User?      @relation(fields: [createdBy], references: [id])
  tags     EventTag[]
  comments Comment[]
  ratings  Rating[]

  @@index([startDate])
  @@index([categoryId])
  @@index([isActive])
  @@index([source])
  @@index([status])
  @@map("events")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  events          Event[]
  telegramSources TelegramSource[]

  @@map("categories")
}

model EventTag {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  tag     String @db.VarChar(100)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([tag])
  @@map("event_tags")
}

model CrawlerSource {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(255)
  baseUrl        String    @map("base_url") @db.VarChar(500)
  scraperType    String    @map("scraper_type") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  lastCrawledAt  DateTime? @map("last_crawled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("crawler_sources")
}

model TelegramSource {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(255)
  chatId        String    @unique @map("chat_id") @db.VarChar(255)
  chatType      String    @map("chat_type") @db.VarChar(50)
  isActive      Boolean   @default(true) @map("is_active")
  lastMessageId Int?      @map("last_message_id")
  lastCrawledAt DateTime? @map("last_crawled_at")
  categoryId    String?   @map("category_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id])

  @@map("telegram_sources")
}

model Comment {
  id              String   @id @default(uuid())
  content         String   @db.Text
  eventId         String   @map("event_id")
  userId          String   @map("user_id")
  parentCommentId String?  @map("parent_comment_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("CommentReplies")
  likes         CommentLike[]

  @@index([eventId])
  @@index([userId])
  @@index([parentCommentId])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

model Rating {
  id        String   @id @default(uuid())
  rating    Int      @db.SmallInt // 1-5
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("ratings")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPPORT
  ORGANIZER
}

enum EventStatus {
  PENDING
  ACCEPTED
  REJECTED
}

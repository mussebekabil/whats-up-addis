// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("users")
}

model Event {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(255)
  description String    @db.Text
  location    String    @db.VarChar(255)
  venue       String    @db.VarChar(255)
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  price       Decimal?  @db.Decimal(10, 2)
  source      String    @db.VarChar(100) // manual or crawler
  sourceUrl   String?   @map("source_url") @db.VarChar(500)
  categoryId  String    @map("category_id")
  createdBy   String?   @map("created_by")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category Category   @relation(fields: [categoryId], references: [id])
  creator  User?      @relation(fields: [createdBy], references: [id])
  tags     EventTag[]

  @@index([startDate])
  @@index([categoryId])
  @@index([isActive])
  @@index([source])
  @@map("events")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  events Event[]

  @@map("categories")
}

model EventTag {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  tag     String @db.VarChar(100)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([tag])
  @@map("event_tags")
}

model CrawlerSource {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(255)
  baseUrl        String    @map("base_url") @db.VarChar(500)
  scraperType    String    @map("scraper_type") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  lastCrawledAt  DateTime? @map("last_crawled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("crawler_sources")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

# Ignore node_modules in all directories
**/node_modules
**/.pnpm-store

# Ignore git
.git
.gitignore

# Ignore build outputs (but not source)
**/build
**/.next
**/.turbo

# Ignore environment files
.env.local
.env*.local
**/.env.local
**/.env*.local

# Ignore logs
*.log
**/*.log

# Ignore OS files
.DS_Store
**/.DS_Store

# Ignore coverage
**/coverage

# Ignore web app (we're only deploying API/Crawler)
apps/web

# Ignore Vercel
.vercel

# Ignore documentation
*.md
!README.md

# Ignore GitHub workflows (not needed in container)
.github

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/whats_up_addis"

# API
API_PORT=3001
API_URL=http://localhost:3001
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Crawler
CRAWLER_SCHEDULE="0 */6 * * *"
CRAWLER_USER_AGENT="WhatsUpAddis/1.0"

# Cloudinary (for image uploads)
# Sign up at https://cloudinary.com/ to get your credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Contact Form (Brevo HTTP API)
# Sign up at brevo.com → Settings → API Keys → Generate a new API key
BREVO_API_KEY=your-brevo-api-key
# Must be a verified sender in your Brevo account (Senders & IPs → Senders)
CONTACT_EMAIL_FROM=noreply@yourdomain.com
CONTACT_EMAIL_TO=theqemari@gmail.com

# Telegram Scraper
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=your_session_string
# TELEGRAM_SCRAPER_MODE=listen   # listen | cron | once (default: listen)
# TELEGRAM_CRAWLER_SCHEDULE="0 */2 * * *"

# Gemini AI (for event extraction in telegram-scraper)
GEMINI_API_KEY=your_gemini_api_key
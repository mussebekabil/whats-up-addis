{
  "name": "whats-up-addis",
  "version": "1.0.0",
  "private": true,
  "description": "Event discovery and management platform for Addis Ababa, Ethiopia",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "local": "pnpm -r --parallel --filter !@whats-up-addis/telegram-scraper dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @whats-up-addis/database db:migrate",
    "db:seed": "pnpm --filter @whats-up-addis/database db:seed",
    "db:migrate:prod": "pnpm --filter @whats-up-addis/database db:migrate:prod",
    "db:generate": "pnpm --filter @whats-up-addis/database db:generate",
    "db:studio": "pnpm --filter @whats-up-addis/database db:studio",
    "api:dev": "pnpm --filter @whats-up-addis/api dev",
    "web:dev": "pnpm --filter @whats-up-addis/web dev",
    "telegram:dev": "pnpm --filter @whats-up-addis/telegram-scraper dev",
    "telegram:scrape": "pnpm --filter @whats-up-addis/telegram-scraper scrape",
    "telegram:generate-session": "pnpm --filter @whats-up-addis/telegram-scraper generate-session",
    "email-scheduler:start": "pnpm --filter @whats-up-addis/email-scheduler start",
    "upload-place-images": "pnpm --filter @whats-up-addis/web upload-place-images"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}

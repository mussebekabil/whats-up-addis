{
  "name": "whats-up-addis",
  "version": "1.0.0",
  "private": true,
  "description": "Event discovery and management platform for Addis Ababa, Ethiopia",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @whats-up-addis/database db:migrate",
    "db:generate": "pnpm --filter @whats-up-addis/database db:generate",
    "db:studio": "pnpm --filter @whats-up-addis/database db:studio",
    "api:dev": "pnpm --filter @whats-up-addis/api dev",
    "web:dev": "pnpm --filter @whats-up-addis/web dev",
    "crawler:dev": "pnpm --filter @whats-up-addis/crawler dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}

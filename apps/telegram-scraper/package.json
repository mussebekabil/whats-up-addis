{
  "name": "@whats-up-addis/telegram-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "scrape": "dotenv -e ../../.env -- tsx src/index.ts",
    "reset": "dotenv -e ../../.env -- tsx src/reset-scraper.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@whats-up-addis/database": "workspace:*",
    "@whats-up-addis/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.32.1",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^7.4.2",
    "telegram": "^2.25.17",
    "input": "^1.0.1",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/whats_up_addis"

# Telegram Configuration (User Account - MTProto API)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# Get these from https://my.telegram.org/apps
# You'll need to login with your phone number to create an app

# LLM Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Get your API key from https://console.anthropic.com/

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Get your credentials from https://cloudinary.com/console

# Telegram Scraper Configuration
TELEGRAM_SCRAPER_MODE=listen
# Options: 'listen' (real-time), 'cron' (scheduled), 'once' (run once and exit)

TELEGRAM_CRAWLER_SCHEDULE="0 */2 * * *"
# Cron schedule (only used when MODE=cron)
# Default: Every 2 hours
